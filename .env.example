# Copy this file to .env and replace the placeholder values. Never commit .env.

# SQL Server "sa" password. Must be at least 8 characters and include
# uppercase, lowercase and digits. Avoid ; and $ (they break the connection
# string / Compose interpolation).
# Note: SQL Server only applies this when the sql_data volume is first created.
MSSQL_SA_PASSWORD=Change-Me-Strong-Passw0rd

# JWT signing key used by the API. Use a long random string (at least 32 chars).
JWT_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
